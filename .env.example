# Copy to .env in the repository root. Relative paths resolve from this directory.
OPENPLAYOUT_DATA_DIR=./data
OPENPLAYOUT_FFPROBE=ffprobe
OPENPLAYOUT_CASPAR_HOST=127.0.0.1
OPENPLAYOUT_CASPAR_PORT=5250
# Bundled server is started automatically with OpenPlayout.
OPENPLAYOUT_CASPAR_AUTOSTART=true
OPENPLAYOUT_CASPAR_MEDIA_ROOT=./media
# Set false for headless operation without a screen/audio consumer.
OPENPLAYOUT_CASPAR_SCREEN=true
OPENPLAYOUT_SCHEDULER_LATENESS_SECONDS=0.5
# OPENPLAYOUT_CASPAR_SERVER_DIR=./.tools/casparcg/2.5.1
OPENPLAYOUT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
# Optional: set a strong token; otherwise data/api-token is generated on first run.
# OPENPLAYOUT_API_TOKEN=
# HTTP address reachable by the CasparCG HTML producer (change for a remote engine).
OPENPLAYOUT_GRAPHICS_BASE_URL=http://127.0.0.1:8000
# Trusted local Python code only; opt-in filenames inside plugins/.
OPENPLAYOUT_TRUSTED_PLUGINS=[]
